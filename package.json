{
  "name": "lyra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "vitest",
    "e2e": "tsx e2e/global-setup.ts && playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "e2e:sim": "playwright test --config playwright.staging.config.ts",
    "smoke:staging": "tsx scripts/lyra.ts staging smoke",
    "eval": "pnpm --filter @lyra/model-gateway eval",
    "mutation": "sh -c 'pnpm --filter @lyra/model-gateway mutation; gw=$?; pnpm --filter @lyra/core mutation; exit $((gw || $?))'",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @lyra/db generate",
    "db:migrate": "pnpm --filter @lyra/db migrate",
    "deploy:staging": "pnpm --filter @lyra/api deploy:staging && pnpm --filter @lyra/web deploy:staging",
    "deploy:prod": "pnpm --filter @lyra/api deploy && pnpm --filter @lyra/web deploy",
    "seed": "pnpm --filter @lyra/core seed",
    "onprem:up": "docker compose -f ops/docker-compose.yml up -d",
    "onprem:down": "docker compose -f ops/docker-compose.yml down",
    "lyra": "tsx scripts/lyra.ts",
    "test:cli": "vitest run scripts",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@lyra/core": "workspace:*",
    "@lyra/db": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=7.29.0",
      "ws": ">=8.21.0",
      "brace-expansion": ">=5.0.9",
      "sharp": ">=0.35.0",
      "vite": ">=8.2.1",
      "js-yaml": ">=4.3.1",
      "nanoid": ">=3.3.17",
      "hono": ">=4.12.34"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq"
      ]
    }
  }
}
