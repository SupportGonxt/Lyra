{
  "name": "@lyra/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rbac": "./src/rbac.ts",
    "./seed": "./src/seed.ts",
    "./totp": "./src/totp.ts",
    "./words": "./src/words.ts",
    "./wikilinks": "./src/wikilinks.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/seed-cli.ts",
    "seed:history": "tsx src/seed-history-cli.ts",
    "mutation": "cd ../.. && stryker run packages/core/stryker.config.mjs"
  },
  "dependencies": {
    "@lyra/db": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@libsql/client": "^0.18.0",
    "@lyra/config": "workspace:*",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "^22",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
